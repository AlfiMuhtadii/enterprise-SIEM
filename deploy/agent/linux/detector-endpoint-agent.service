# Place a filled-in config.json at /etc/detector/agent/config.json before starting
# this unit -- copy services/endpoint-agent/config.json.example and set at least
# ingestion_gateway_url, ingestion_gateway_secret, soc_api_url, enrollment_token,
# state_path, and buffer_path (e.g. under /var/lib/detector/, owned by the
# detector user/group below).
[Unit]
Description=Detector Lightweight Endpoint Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/detector
ExecStart=/usr/bin/python3 /opt/detector/services/endpoint-agent/agent.py --config /etc/detector/agent/config.json
Restart=always
RestartSec=10
User=detector
Group=detector

[Install]
WantedBy=multi-user.target

