APP_NAME=DetectorSOC
APP_ENV=production
APP_KEY=base64:REPLACE_WITH_GENERATED_KEY
APP_DEBUG=false
APP_URL=https://detector.example
TRUSTED_PROXIES=*
APP_FORCE_HTTPS=true

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=detector
DB_USERNAME=detector
DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true

SOC_API_RATE_LIMIT_PER_MINUTE=120
SOC_EXPORT_MAX_ROWS=500
SOC_WEBHOOK_SECRET=REPLACE_WITH_STRONG_WEBHOOK_SECRET
SOC_WEBHOOK_URL=
SOC_SLACK_URL=
SOC_DISCORD_URL=
SOC_AGENT_ENROLLMENT_TOKEN=REPLACE_WITH_STRONG_AGENT_ENROLLMENT_TOKEN
SOC_AGENT_HEARTBEAT_INTERVAL_SECONDS=60
SOC_AGENT_OFFLINE_AFTER_SECONDS=180
SOC_AGENT_LATEST_VERSION=0.2.0
SOC_AGENT_RETRY_QUEUE_ALERT_THRESHOLD=1000
SOC_AGENT_DELIVERY_FAILURE_ALERT_THRESHOLD=5
SOC_AI_PROVIDER=local
SOC_AI_ENABLED=true
SOC_AI_MODEL=local-heuristic
SOC_AI_TIMEOUT_SECONDS=20
SOC_AI_RETRY_ATTEMPTS=1
SOC_OPENAI_COMPATIBLE_BASE_URL=
SOC_OPENAI_COMPATIBLE_API_KEY=
SOC_OLLAMA_BASE_URL=http://ollama:11434
SOC_OLLAMA_MODEL=llama3.1

KAFKA_REST_URL=http://redpanda:8082
TELEMETRY_TOPIC=telemetry_events
TELEMETRY_GROUP_ID=telemetry-worker-production
SECURITY_INGEST_DSN=
BACKUP_DIR=storage/backups
