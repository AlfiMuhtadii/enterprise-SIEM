APP_NAME=DetectorSOC
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
TRUSTED_PROXIES=127.0.0.1,::1
APP_FORCE_HTTPS=false

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=detector
DB_USERNAME=postgres
DB_PASSWORD=postgres

QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_SECURE_COOKIE=false

SOC_API_RATE_LIMIT_PER_MINUTE=120
SOC_EXPORT_MAX_ROWS=500
SOC_WEBHOOK_SECRET=local-dev-secret
SOC_WEBHOOK_URL=
SOC_SLACK_URL=
SOC_DISCORD_URL=

KAFKA_REST_URL=http://127.0.0.1:8082
TELEMETRY_TOPIC=telemetry_events
TELEMETRY_GROUP_ID=telemetry-worker-local
SECURITY_INGEST_DSN=
BACKUP_DIR=storage/backups

