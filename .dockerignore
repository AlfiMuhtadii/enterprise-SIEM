# PROD-IMAGE-HERMETIC-ASSETS: deny-by-default so a dirty local checkout
# can't leak unrelated files (secrets, local reports, .git history) into
# the production image, and so building from a clean checkout doesn't
# need any prior host-side `npm`/`composer` step -- the Dockerfile's own
# node-build/composer-build stages produce vendor/ and public/build/.

# VCS
.git
.gitignore
.gitattributes

# Local env / secrets -- runtime config comes from `env_file:`/`environment:`
# in docker-compose.yml, never baked into the image.
.env
.env.*
!.env.example
!.env.production.example

# Dependencies rebuilt inside the image, not copied from the host
vendor
node_modules
public/build

# Regenerated by the Dockerfile's `package:discover`/entrypoint's
# `config:cache`/`view:cache`. Excluding these is not just cleanliness: a
# host-generated bootstrap/cache/services.php (from a *dev* `composer
# install` including packages like nunomaduro/collision) copied into the
# image breaks Laravel's bootstrap the moment the image's --no-dev vendor
# is swapped in -- the cached provider list references a class that no
# longer exists, and every artisan command (including package:discover
# itself) fails before it can regenerate the file. Found live while
# building this image, not assumed.
bootstrap/cache/*.php

# Local dev / IDE
.idea
.vscode
*.log

# Test artifacts, reports, docs -- not needed at runtime
tests
docs
reports
storage/logs/*.jsonl
storage/logs/*.log
storage/resilience/*.json
.ci-go-cache
.ci-go-mod

# CI/CD
.github

# Non-web services this image doesn't run (kept out to shrink the
# `COPY . .` context -- Go/Python services build their own images)
services
scripts/__pycache__

# Scenario/demo data not needed by the app/queue/scheduler containers
storage/app/demo
