APP_NAME=DetectorSOC
APP_ENV=staging
APP_KEY=base64:CHANGE_ME
APP_DEBUG=false
APP_URL=https://staging-detector.example
TRUSTED_PROXIES=*
APP_FORCE_HTTPS=true

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=detector_staging
DB_USERNAME=detector
DB_PASSWORD=change-me

QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true

SOC_API_RATE_LIMIT_PER_MINUTE=120
SOC_EXPORT_MAX_ROWS=1000
SOC_WEBHOOK_SECRET=change-me
SOC_WEBHOOK_URL=
SOC_SLACK_URL=
SOC_DISCORD_URL=
SOC_AGENT_ENROLLMENT_TOKEN=change-me
SOC_AGENT_HEARTBEAT_INTERVAL_SECONDS=60
SOC_AGENT_OFFLINE_AFTER_SECONDS=180
SOC_AGENT_LATEST_VERSION=0.2.0
SOC_AGENT_RETRY_QUEUE_ALERT_THRESHOLD=1000
SOC_AGENT_DELIVERY_FAILURE_ALERT_THRESHOLD=5

# Tenant isolation — MUST be true in staging to mirror production posture
XDR_TENANT_STRICT_MODE=true

# XDR Internal Auth — MUST be true in staging
XDR_ENFORCE_INTERNAL_AUTH=true

# XDR Ingestion & Internal Auth (required — generate with: openssl rand -hex 32)
XDR_INGEST_SECRET=REPLACE_WITH_STRONG_INGEST_SECRET
XDR_INTERNAL_AUTH_SECRET=REPLACE_WITH_STRONG_INTERNAL_AUTH_SECRET
XDR_NORMALIZER_INTERNAL_TOKEN=REPLACE_WITH_STRONG_NORMALIZER_TOKEN
XDR_ALERT_WRITER_INTERNAL_TOKEN=REPLACE_WITH_STRONG_ALERT_WRITER_TOKEN
XDR_INCIDENT_BUILDER_INTERNAL_TOKEN=REPLACE_WITH_STRONG_INCIDENT_BUILDER_TOKEN
XDR_CORRELATION_INTERNAL_TOKEN=REPLACE_WITH_STRONG_CORRELATION_TOKEN

# Shadow / DLQ consumers — keep false by default in staging
XDR_SHADOW_CONSUMER_ENABLED=false
XDR_DLQ_CONSUMER_ENABLED=false
XDR_CORRELATION_DLQ_CONSUMER_ENABLED=false
XDR_ALERT_WRITE_DLQ_CONSUMER_ENABLED=false

KAFKA_REST_URL=http://redpanda:8082
TELEMETRY_TOPIC=telemetry_events
TELEMETRY_GROUP_ID=telemetry-worker-staging
SECURITY_INGEST_DSN=
BACKUP_DIR=storage/backups
