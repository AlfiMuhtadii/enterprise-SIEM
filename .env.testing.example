# .env.testing.example — dedicated test environment
#
# Copy to .env.testing ONLY if you run artisan commands with --env=testing
# (e.g. `php artisan migrate --env=testing`). For `php artisan test` / phpunit
# you do NOT need this file: phpunit.xml already overrides DB_DATABASE to the
# dedicated test database, so tests always use their own DB regardless of .env.
#
# IMPORTANT: Laravel REPLACES .env with .env.testing (it does not merge). If you
# create a real .env.testing it must be COMPLETE — copy your working .env, then
# change only the values below. Do NOT commit a real .env.testing with secrets.

APP_ENV=testing
APP_KEY=              # run: php artisan key:generate --env=testing
APP_DEBUG=true

# Dedicated test database — NEVER the app/dev database (detector).
# One-time create:  createdb detector_test
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=detector_test
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Fast, side-effect-free drivers for tests (mirror phpunit.xml)
BCRYPT_ROUNDS=4
CACHE_DRIVER=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
TELESCOPE_ENABLED=false
PULSE_ENABLED=false

# Internal-auth stays permissive in tests (no enforced tokens needed offline)
XDR_ENFORCE_INTERNAL_AUTH=false
