{
  "__inputs": [
    {
      "name": "DS_POSTGRES",
      "label": "PostgreSQL",
      "description": "PostgreSQL data source (SOC platform DB)",
      "type": "datasource",
      "pluginId": "postgres",
      "pluginName": "PostgreSQL"
    }
  ],
  "__requires": [
    { "type": "grafana",    "id": "grafana",    "name": "Grafana",    "version": "10.0.0" },
    { "type": "datasource", "id": "postgres",   "name": "PostgreSQL", "version": "1.0.0" },
    { "type": "panel",      "id": "timeseries", "name": "Time series","version": "" },
    { "type": "panel",      "id": "table",      "name": "Table",      "version": "" },
    { "type": "panel",      "id": "stat",       "name": "Stat",       "version": "" },
    { "type": "panel",      "id": "barchart",   "name": "Bar chart",  "version": "" },
    { "type": "panel",      "id": "piechart",   "name": "Pie chart",  "version": "" }
  ],
  "annotations": { "list": [] },
  "description": "Investigation workflow orchestration — state distribution, SLA, analyst workload, escalations, false positives, resolution trends.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "fieldConfig": { "defaults": { "color": { "fixedColor": "purple", "mode": "fixed" } }, "overrides": [] },
      "gridPos": { "h": 4, "w": 3, "x": 0, "y": 0 }, "id": 1,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "textMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Investigating",
      "type": "stat",
      "targets": [{ "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" }, "rawSql": "SELECT count(*) AS value FROM investigations WHERE state = 'investigating'", "format": "table", "refId": "A" }]
    },
    {
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "fieldConfig": { "defaults": { "color": { "fixedColor": "red", "mode": "fixed" } }, "overrides": [] },
      "gridPos": { "h": 4, "w": 3, "x": 3, "y": 0 }, "id": 2,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "textMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Escalated",
      "type": "stat",
      "targets": [{ "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" }, "rawSql": "SELECT count(*) AS value FROM investigations WHERE state = 'escalated'", "format": "table", "refId": "A" }]
    },
    {
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "fieldConfig": { "defaults": { "color": { "fixedColor": "cyan", "mode": "fixed" } }, "overrides": [] },
      "gridPos": { "h": 4, "w": 3, "x": 6, "y": 0 }, "id": 3,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "textMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Open (total)",
      "type": "stat",
      "targets": [{ "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" }, "rawSql": "SELECT count(*) AS value FROM investigations WHERE state NOT IN ('closed','false_positive')", "format": "table", "refId": "A" }]
    },
    {
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "fieldConfig": { "defaults": { "color": { "fixedColor": "yellow", "mode": "fixed" } }, "overrides": [] },
      "gridPos": { "h": 4, "w": 3, "x": 9, "y": 0 }, "id": 4,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "textMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "False Positives",
      "type": "stat",
      "targets": [{ "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" }, "rawSql": "SELECT count(*) AS value FROM investigations WHERE state = 'false_positive'", "format": "table", "refId": "A" }]
    },
    {
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "fieldConfig": { "defaults": { "color": { "fixedColor": "green", "mode": "fixed" } }, "overrides": [] },
      "gridPos": { "h": 4, "w": 3, "x": 12, "y": 0 }, "id": 5,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "textMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Resolved This Week",
      "type": "stat",
      "targets": [{ "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" }, "rawSql": "SELECT count(*) AS value FROM investigations WHERE state = 'resolved' AND resolved_at >= NOW() - INTERVAL '7 days'", "format": "table", "refId": "A" }]
    },
    {
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "fieldConfig": { "defaults": { "custom": { "align": "auto", "displayMode": "auto" }, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 3 }, { "color": "red", "value": 5 }] } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 }, "id": 6,
      "options": { "footer": { "show": false }, "showHeader": true, "sortBy": [{ "desc": true, "displayName": "count" }] },
      "title": "Analyst Workload (Active Assignments)",
      "type": "table",
      "targets": [{ "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" }, "rawSql": "SELECT u.name AS analyst, u.role, count(i.id) AS count, array_agg(i.severity ORDER BY CASE i.severity WHEN 'critical' THEN 1 WHEN 'high' THEN 2 ELSE 3 END) AS severities FROM investigation_assignments a JOIN users u ON u.id = a.assigned_to_user_id JOIN investigations i ON i.id = a.investigation_id WHERE a.is_active = true AND i.state NOT IN ('closed','false_positive') GROUP BY u.name, u.role ORDER BY count DESC", "format": "table", "refId": "A" }]
    },
    {
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "fieldConfig": { "defaults": { "custom": { "align": "auto", "displayMode": "auto" } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 }, "id": 7,
      "options": { "footer": { "show": false }, "showHeader": true, "sortBy": [{ "desc": true, "displayName": "created_at" }] },
      "title": "Active Escalations",
      "type": "table",
      "targets": [{ "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" }, "rawSql": "SELECT investigation_id, title, severity, priority, assignee.name AS assignee, created_at FROM investigations LEFT JOIN users assignee ON assignee.id = assigned_to WHERE state = 'escalated' ORDER BY created_at ASC LIMIT 20", "format": "table", "refId": "A" }]
    },
    {
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "fillOpacity": 10, "lineWidth": 2 } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 }, "id": 8,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "title": "Investigation Creation Rate",
      "type": "timeseries",
      "targets": [{ "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" }, "rawSql": "SELECT date_trunc('day', created_at) AS time, severity, count(*) AS created FROM investigations WHERE $__timeFilter(created_at) GROUP BY date_trunc('day', created_at), severity ORDER BY time", "format": "table", "refId": "A" }]
    },
    {
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "fillOpacity": 10, "lineWidth": 2 } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 }, "id": 9,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "title": "Investigation Resolution Trend",
      "type": "timeseries",
      "targets": [{ "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" }, "rawSql": "SELECT date_trunc('day', resolved_at) AS time, count(*) AS resolved FROM investigations WHERE resolved_at IS NOT NULL AND $__timeFilter(resolved_at) GROUP BY date_trunc('day', resolved_at) ORDER BY time", "format": "table", "refId": "A" }]
    },
    {
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "fillOpacity": 10, "lineWidth": 2 } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 }, "id": 10,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "title": "Escalation Volume Over Time",
      "type": "timeseries",
      "targets": [{ "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" }, "rawSql": "SELECT date_trunc('day', occurred_at) AS time, count(*) AS escalations FROM investigation_events WHERE event_type = 'state_transition' AND to_state = 'escalated' AND $__timeFilter(occurred_at) GROUP BY date_trunc('day', occurred_at) ORDER BY time", "format": "table", "refId": "A" }]
    },
    {
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "fillOpacity": 10, "lineWidth": 2 } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 }, "id": 11,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "title": "False Positive Trend",
      "type": "timeseries",
      "targets": [{ "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" }, "rawSql": "SELECT date_trunc('day', closed_at) AS time, count(*) AS false_positives FROM investigations WHERE state = 'false_positive' AND closed_at IS NOT NULL AND $__timeFilter(closed_at) GROUP BY date_trunc('day', closed_at) ORDER BY time", "format": "table", "refId": "A" }]
    },
    {
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "fieldConfig": { "defaults": { "custom": { "align": "auto", "displayMode": "auto" } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 28 }, "id": 12,
      "options": { "footer": { "show": false }, "showHeader": true },
      "title": "Investigation SLA — Time to Triage (hours from creation)",
      "type": "table",
      "targets": [{ "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" }, "rawSql": "SELECT investigation_id, title, severity, ROUND(EXTRACT(EPOCH FROM (triage_at - created_at)) / 3600, 1) AS hours_to_triage, state FROM investigations WHERE triage_at IS NOT NULL AND $__timeFilter(created_at) ORDER BY hours_to_triage DESC LIMIT 30", "format": "table", "refId": "A" }]
    }
  ],
  "refresh": "1m",
  "schemaVersion": 38,
  "tags": ["xdr", "investigation", "workflow", "soc"],
  "time": { "from": "now-7d", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "XDR Investigation Workflow Dashboard",
  "uid": "xdr-investigation-workflow-v1",
  "version": 1
}
