APP_NAME=DetectorSOC
APP_ENV=production
APP_KEY=base64:REPLACE_WITH_GENERATED_KEY
APP_DEBUG=false
APP_URL=https://detector.example
TRUSTED_PROXIES=*
APP_FORCE_HTTPS=true

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=detector
DB_USERNAME=detector
DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true

SOC_API_RATE_LIMIT_PER_MINUTE=120
SOC_EXPORT_MAX_ROWS=500
SOC_WEBHOOK_SECRET=REPLACE_WITH_STRONG_WEBHOOK_SECRET
SOC_WEBHOOK_URL=
SOC_SLACK_URL=
SOC_DISCORD_URL=
SOC_AGENT_ENROLLMENT_TOKEN=REPLACE_WITH_STRONG_AGENT_ENROLLMENT_TOKEN
SOC_AGENT_HEARTBEAT_INTERVAL_SECONDS=60
SOC_AGENT_OFFLINE_AFTER_SECONDS=180
SOC_AGENT_LATEST_VERSION=0.2.0
SOC_AGENT_RETRY_QUEUE_ALERT_THRESHOLD=1000
SOC_AGENT_DELIVERY_FAILURE_ALERT_THRESHOLD=5
SOC_AI_PROVIDER=local
SOC_AI_ENABLED=true
SOC_AI_MODEL=local-heuristic
SOC_AI_TIMEOUT_SECONDS=20
SOC_AI_RETRY_ATTEMPTS=1
SOC_OPENAI_COMPATIBLE_BASE_URL=
SOC_OPENAI_COMPATIBLE_API_KEY=
SOC_OLLAMA_BASE_URL=http://ollama:11434
SOC_OLLAMA_MODEL=llama3.1
SOC_TI_VIRUSTOTAL_API_KEY=
SOC_TI_ABUSEIPDB_API_KEY=
SOC_TI_MISP_BASE_URL=
SOC_TI_MISP_API_KEY=
SOC_TI_OPENCTI_BASE_URL=
SOC_TI_OPENCTI_API_KEY=
SOC_TI_WEBHOOK_URL=
SOC_RAG_VECTOR_STORE=local-keyword
SOC_RAG_EMBEDDING_PROVIDER=local-keyword
SOC_QDRANT_BASE_URL=http://qdrant:6333
SOC_QDRANT_COLLECTION=soc_knowledge

# Tenant isolation — MUST be true in production
XDR_TENANT_STRICT_MODE=true

# XDR Internal Auth — MUST be true in production
# Each service fails fast at startup if its token is missing when enforced.
XDR_ENFORCE_INTERNAL_AUTH=true

# XDR Ingestion & Internal Auth (required — generate with: openssl rand -hex 32)
XDR_INGEST_SECRET=REPLACE_WITH_STRONG_INGEST_SECRET
XDR_INTERNAL_AUTH_SECRET=REPLACE_WITH_STRONG_INTERNAL_AUTH_SECRET
XDR_NORMALIZER_INTERNAL_TOKEN=REPLACE_WITH_STRONG_NORMALIZER_TOKEN
XDR_ALERT_WRITER_INTERNAL_TOKEN=REPLACE_WITH_STRONG_ALERT_WRITER_TOKEN
XDR_INCIDENT_BUILDER_INTERNAL_TOKEN=REPLACE_WITH_STRONG_INCIDENT_BUILDER_TOKEN
XDR_CORRELATION_INTERNAL_TOKEN=REPLACE_WITH_STRONG_CORRELATION_TOKEN

# Shadow / DLQ consumers — advisory-only; must remain false in production
# Enable only when actively monitoring shadow domain soak evidence.
XDR_SHADOW_CONSUMER_ENABLED=false
XDR_DLQ_CONSUMER_ENABLED=false
XDR_CORRELATION_DLQ_CONSUMER_ENABLED=false
XDR_ALERT_WRITE_DLQ_CONSUMER_ENABLED=false

# Consumer offset policy — use latest in production to skip stale messages on fresh start
XDR_ALERT_WRITER_AUTO_OFFSET_RESET=latest
XDR_INCIDENT_BUILDER_AUTO_OFFSET_RESET=latest

# XDR Service URLs
XDR_REDPANDA_REST_URL=http://redpanda:8082
XDR_CORRELATION_WORKER_URL=http://correlation-worker:8093
XDR_ALERT_WRITER_URL=http://alert-writer-service:8095
XDR_INCIDENT_BUILDER_URL=http://incident-builder-service:8096
XDR_AI_RAG_SERVICE_URL=http://ai-rag-service:8094

# XDR Correlation Engine
XDR_CORRELATION_ENGINE=go
XDR_CORRELATION_SCOPE=identity-cloud
XDR_CORRELATION_FALLBACK_TO_LEGACY=true
XDR_CORRELATION_HEALTH_TIMEOUT_SECONDS=5
XDR_CORRELATION_HEALTH_RETRIES=2
XDR_CORRELATION_HEALTH_RETRY_SLEEP_MS=150
XDR_CORRELATION_FALLBACK_FAILURE_THRESHOLD=3

# XDR Cutover Gates
XDR_CORRELATION_SHADOW_REPORT=reports/xdr_cutover_active_identity_cloud_saas.json
XDR_CORRELATION_ALERT_TYPE_MATCH_MIN=0.95
XDR_CORRELATION_ALERT_COUNT_DELTA_MAX=0.02
XDR_CORRELATION_EVIDENCE_MATCH_MIN=0.98
XDR_CORRELATION_P95_LATENCY_MS_MAX=300
XDR_CORRELATION_DUPLICATE_RATE_MAX=0
XDR_CORRELATION_GOGC=300

# XDR Topics
XDR_EVENT_LOOP_ENABLED=true
XDR_ALERTS_TOPIC=xdr.alerts
XDR_ALERTS_CREATED_TOPIC=alerts.created
XDR_INCIDENTS_TOPIC=incidents.updated
XDR_DB_HOST=postgres

KAFKA_REST_URL=http://redpanda:8082
TELEMETRY_TOPIC=telemetry_events
TELEMETRY_GROUP_ID=telemetry-worker-production
SECURITY_INGEST_DSN=
BACKUP_DIR=storage/backups
