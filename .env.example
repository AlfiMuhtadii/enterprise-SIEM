APP_NAME="XDR SOC Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
TRUSTED_PROXIES=127.0.0.1,::1
APP_FORCE_HTTPS=false

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=detector
DB_USERNAME=postgres
DB_PASSWORD=postgres
# ENT-SEC-NO-TLS-INTERNAL: 'prefer' (opportunistic TLS) by default, matching
# prior behavior. Tighten to 'verify-full' only if the Postgres server has
# real TLS configured with a verifiable cert.
DB_SSLMODE=prefer
DB_SSLROOTCERT=
DB_SSLCERT=
DB_SSLKEY=
XDR_RESTORE_TARGET_DB=detector_restore_drill

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_CA_BUNDLE=
AWS_USE_PATH_STYLE_ENDPOINT=false

# DATA-TIERING (cold tier): off by default. To use the local MinIO instance
# (`docker compose --profile data-tiering up -d minio`), set:
#   XDR_DATA_TIERING_COLD_TIER_ENABLED=true
#   AWS_ACCESS_KEY_ID=detector
#   AWS_SECRET_ACCESS_KEY=detector-minio-dev
#   AWS_BUCKET=detector-archive
#   AWS_ENDPOINT=http://127.0.0.1:9000
#   AWS_CA_BUNDLE=
#   AWS_USE_PATH_STYLE_ENDPOINT=true
# (create the bucket once via the MinIO console at http://127.0.0.1:9001)
XDR_DATA_TIERING_COLD_TIER_ENABLED=false
XDR_DATA_TIERING_COLD_TIER_DISK=s3
XDR_DATA_TIERING_COLD_TIER_PREFIX=archive

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

SOC_API_RATE_LIMIT_PER_MINUTE=120
# IDENTITY-SSO-MFA: mandatory MFA on response-plan/active-response/erasure
# approval routes. Off by default (see config/soc.php's mfa_enforcement_enabled comment).
SOC_MFA_ENFORCEMENT_ENABLED=false
# IDENTITY-SSO-MFA: OIDC SSO federation login (config/oidc.php). Off by
# default -- no real external IdP configured; a per-user TOTP second
# factor (if enabled) is still enforced after SSO login. See
# app/Services/OidcSsoService.php.
SOC_OIDC_SSO_ENABLED=false
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ISSUER=
OIDC_AUTHORIZATION_ENDPOINT=
OIDC_TOKEN_ENDPOINT=
OIDC_JWKS_URI=
# Empty (default) -- computed from the sso.oidc.callback route at request time.
OIDC_REDIRECT_URI=
OIDC_SCOPES="openid profile email"
OIDC_JWKS_CACHE_SECONDS=3600
# IDENTITY-SSO-MFA: SAML 2.0 SSO federation login (config/saml.php). Off by
# default -- no real external IdP configured; a per-user TOTP second
# factor (if enabled) is still enforced after SSO login. See
# app/Services/SamlSsoService.php.
SOC_SAML_SSO_ENABLED=false
SAML_SP_ENTITY_ID=
# Empty (default) -- computed from the sso.saml.acs route at request time.
SAML_SP_ACS_URL=
SAML_IDP_ENTITY_ID=
SAML_IDP_SSO_URL=
SAML_IDP_X509_CERT=
SOC_EXPORT_MAX_ROWS=500
SOC_WEBHOOK_SECRET=
SOC_WEBHOOK_URL=
SOC_SLACK_URL=
SOC_DISCORD_URL=
SOC_AGENT_ENROLLMENT_TOKEN=
SOC_AGENT_HEARTBEAT_INTERVAL_SECONDS=60
SOC_AGENT_OFFLINE_AFTER_SECONDS=180
SOC_AGENT_LATEST_VERSION=0.2.0
SOC_AGENT_RETRY_QUEUE_ALERT_THRESHOLD=1000
SOC_AGENT_DELIVERY_FAILURE_ALERT_THRESHOLD=5

KAFKA_REST_URL=http://127.0.0.1:8082
TELEMETRY_TOPIC=telemetry_events
TELEMETRY_GROUP_ID=telemetry-worker-v1
SECURITY_INGEST_DSN=
# PERF-DB-CONN-LEAK: bounded psycopg_pool.ConnectionPool sizing for
# alert-writer-service / incident-builder-service (services/*/pg_pool.py).
# Safe defaults; raise DB_POOL_MAX_SIZE before a high-concurrency pilot.
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
DB_POOL_TIMEOUT_SECONDS=5
BACKUP_DIR=storage/backups

# XDR Ingestion & Internal Auth (required — generate with: openssl rand -hex 32)
XDR_INGEST_SECRET=
# HMAC-SHA256 shared secret for internal service-to-service auth.
# Unset = falls back to APP_KEY (safe for local demo; validator will WARN).
XDR_INTERNAL_AUTH_SECRET=
# Per-service internal endpoint tokens. Required when XDR_ENFORCE_INTERNAL_AUTH=true.
# Generate each independently: openssl rand -hex 32
XDR_NORMALIZER_INTERNAL_TOKEN=
XDR_ALERT_WRITER_INTERNAL_TOKEN=
XDR_INCIDENT_BUILDER_INTERNAL_TOKEN=
XDR_CORRELATION_INTERNAL_TOKEN=
# AI-1: ai-rag-service /v1/analyze, /v1/retrieve, /v1/embed had zero auth of
# any kind. Sent by Laravel's AiRagServiceProvider as X-Internal-Service-Token
# when non-empty (config/soc.php's ai_internal_token).
XDR_AI_RAG_INTERNAL_TOKEN=
# Set to true to require X-Internal-Service-Token on all internal HTTP endpoints
# (normalizer /v1/normalize, alert-writer /v1/write + /v1/process,
#  incident-builder /v1/build + /v1/process, correlation-worker /v1/correlate,
#  ai-rag-service /v1/analyze + /v1/retrieve + /v1/embed).
# Each service fails fast at startup if its token is not configured when enforced.
# Default: false (local demo compatible). Set true for any non-local deployment.
XDR_ENFORCE_INTERNAL_AUTH=false

# ENT-SEC-NO-TLS-INTERNAL (phase 1): internal mTLS for ingestion-gateway.
# Generate dev/test certs: python scripts/xdr_generate_internal_mtls_certs.py --generate
# (writes to storage/certs/internal-mtls/, gitignored). Default: false — plain
# HTTP, byte-for-byte unchanged behavior. Phase 1 covers ingestion-gateway
# only (server + its own outbound httpClient); remaining services are a
# separate, deferred phase — see REVIEW_BACKLOG.md.
XDR_INTERNAL_MTLS_ENABLED=false
XDR_INTERNAL_MTLS_REQUIRED=false
XDR_INTERNAL_MTLS_CA=storage/certs/internal-mtls/ca.crt
XDR_INTERNAL_MTLS_SERVER_CERT=storage/certs/internal-mtls/server.crt
XDR_INTERNAL_MTLS_SERVER_KEY=storage/certs/internal-mtls/server.key
XDR_INTERNAL_MTLS_CLIENT_CERT=storage/certs/internal-mtls/client.crt
XDR_INTERNAL_MTLS_CLIENT_KEY=storage/certs/internal-mtls/client.key

# OBS-OTEL-TRACING: OTLP/HTTP+JSON span export from the whole platform —
# the 3 core Go pipeline services (ingestion-gateway, normalizer-worker,
# correlation-worker), the 2 Python services (alert-writer-service,
# incident-builder-service), and the Laravel SOC control plane
# (SecurityRequestLogger) — turns the existing W3C traceparent propagation
# into actual spans a real OTel collector can ingest at "<endpoint>/v1/traces".
# Empty (default) disables export entirely — zero behavior/latency change
# until an operator points this at a real collector. No live collector is
# available in this environment; verified against local mock HTTP servers
# instead (see internal/otlpexport (Go), otlp_export.py (Python), and
# OtlpExportService (PHP) tests in each service).
XDR_OTEL_EXPORTER_ENDPOINT=

# SECRETS-VAULT: pluggable secret-provider backend. Default 'env' is
# behavior-identical to the vars above. 'vault' additionally consults a
# HashiCorp Vault KV-v2 path (see docs/security/SECRET_ROTATION_RUNBOOK.md).
XDR_SECRET_BACKEND=env
XDR_VAULT_ADDR=
XDR_VAULT_TOKEN=
XDR_VAULT_SECRET_PATH=secret/data/xdr
XDR_VAULT_TIMEOUT_SECONDS=5

# Tenant strict mode (BACKLOG-TENANCY-021).
# false (default) = legacy/migration mode: zero-membership users pass through,
#   missing X-Tenant-ID header is not rejected on object-scoped routes.
# true = production posture: zero-membership users with any header are rejected,
#   missing header on show/review routes returns 403.
# MUST be true before multi-tenant production go-live.
# See docs/security/TENANT_STRICT_MODE.md before enabling.
XDR_TENANT_STRICT_MODE=false
XDR_TENANT_RLS_SESSION_CONTEXT_ENABLED=false

# Structured failure topics for durable failure records (BACKLOG-016).
# Bootstrap these with: python scripts/xdr_topic_bootstrap.py
# correlation-worker writes parse/publish failures to xdr.correlation_failed.
# alert-writer writes postgres/opensearch/event-loop failures to xdr.alert_write_failed.
XDR_CORRELATION_FAILED_TOPIC=xdr.correlation_failed
XDR_ALERT_WRITE_FAILED_TOPIC=xdr.alert_write_failed

# XDR Service URLs
XDR_REDPANDA_REST_URL=http://127.0.0.1:8082
# ARCH-KAFKA-NATIVE: ingestion-gateway/normalizer-worker/correlation-worker
# talk to Redpanda via Pandaproxy (above) by default. Set to "native" to use
# the native binary Kafka protocol instead (host-side scripts/tests would
# use 127.0.0.1:19092 -- the OUTSIDE listener -- not 9092, which is
# container-network-only; see docker-compose.yml's redpanda service).
XDR_KAFKA_TRANSPORT=pandaproxy
XDR_REDPANDA_KAFKA_BROKERS=redpanda:9092
# Set brokers to redpanda:9093 in Compose (or 127.0.0.1:19093 from the host)
# when enabling the additive native Kafka TLS listener.
XDR_REDPANDA_KAFKA_TLS_ENABLED=false
XDR_REDPANDA_KAFKA_CA_CERT=storage/certs/internal-mtls/ca.crt
XDR_REDPANDA_KAFKA_CLIENT_CERT=
XDR_REDPANDA_KAFKA_CLIENT_KEY=
XDR_NORMALIZER_NATIVE_GROUP=
XDR_CORRELATION_NATIVE_GROUP=
XDR_CORRELATION_WORKER_URL=http://127.0.0.1:8093
XDR_ALERT_WRITER_URL=http://127.0.0.1:8095
XDR_INCIDENT_BUILDER_URL=http://127.0.0.1:8096
XDR_AI_RAG_SERVICE_URL=http://127.0.0.1:8094

# XDR Correlation Engine
XDR_CORRELATION_ENGINE=go
XDR_CORRELATION_SCOPE=identity-cloud
XDR_CORRELATION_FALLBACK_TO_LEGACY=true
XDR_CORRELATION_HEALTH_TIMEOUT_SECONDS=5
XDR_CORRELATION_HEALTH_RETRIES=2
XDR_CORRELATION_HEALTH_RETRY_SLEEP_MS=150
XDR_CORRELATION_FALLBACK_FAILURE_THRESHOLD=3

# XDR Cutover Gates
XDR_CORRELATION_SHADOW_REPORT=reports/xdr_cutover_active_identity_cloud_saas.json
XDR_CORRELATION_ALERT_TYPE_MATCH_MIN=0.95
XDR_CORRELATION_ALERT_COUNT_DELTA_MAX=0.02
XDR_CORRELATION_EVIDENCE_MATCH_MIN=0.98
XDR_CORRELATION_P95_LATENCY_MS_MAX=300
XDR_CORRELATION_DUPLICATE_RATE_MAX=0
XDR_CORRELATION_GOGC=300

# XDR Event Loop Flags
# XDR_CORRELATION_EVENT_LOOP_ENABLED — enables Redpanda consumer in correlation-worker
#   (docker-compose.yml hardcodes this to "true" for the strangler profile container;
#    set here for local / out-of-Docker dev and for validate_live_xdr_pipeline.py)
XDR_CORRELATION_EVENT_LOOP_ENABLED=true
# XDR_EVENT_LOOP_ENABLED — enables Redpanda consumer in alert-writer-service
#   (these are independent flags for two separate Go/Python services)
XDR_EVENT_LOOP_ENABLED=true

# Shadow Alert Consumer — advisory findings (separate from security_alerts; no incidents created)
# Enable to consume xdr.alerts.shadow.endpoint and xdr.alerts.shadow.network into advisory_findings table.
# Default false — explicit opt-in required.
XDR_SHADOW_CONSUMER_ENABLED=false
XDR_SHADOW_ENDPOINT_TOPIC=xdr.alerts.shadow.endpoint
XDR_SHADOW_NETWORK_TOPIC=xdr.alerts.shadow.network

# DLQ Consumer — normalization failures (separate from security_alerts; no incidents created)
# Enable to consume telemetry.normalization_failed into dlq_records table for SOC review.
# Replay via: php artisan dlq:replay  (never auto-triggered from HTTP)
# Default false — explicit opt-in required.
XDR_DLQ_CONSUMER_ENABLED=false
XDR_DLQ_TOPIC=telemetry.normalization_failed
# Pipeline DLQ consumers — correlation/alert-write failures; advisory-only, never auto-replay
XDR_CORRELATION_DLQ_CONSUMER_ENABLED=false
XDR_ALERT_WRITE_DLQ_CONSUMER_ENABLED=false
XDR_NORMALIZER_URL=http://127.0.0.1:8092

# XDR Consumer Offset Reset Policy
# Controls auto.offset.reset for Pandaproxy consumers when no committed offset exists
# or when the committed offset is out of range (partition log has advanced past it).
# Use "earliest" for demo/local to replay all available messages.
# Use "latest" in production to skip old messages on fresh consumer group start.
XDR_ALERT_WRITER_AUTO_OFFSET_RESET=earliest
XDR_INCIDENT_BUILDER_AUTO_OFFSET_RESET=earliest

# Go consumer group names — set a unique timestamp suffix on each fresh deploy
# to avoid inheriting stale committed offsets after Redpanda restart/volume wipe.
# Leave empty to use stable defaults (normalizer-worker-v1 / correlation-worker-v1).
XDR_NORMALIZER_GROUP=normalizer-worker-v1
XDR_CORRELATION_GROUP=correlation-worker-v1

# XDR Topics
XDR_ALERTS_TOPIC=xdr.alerts
XDR_ALERTS_CREATED_TOPIC=alerts.created
XDR_INCIDENTS_TOPIC=incidents.updated
XDR_DB_HOST=host.docker.internal

# AI / RAG
SOC_AI_PROVIDER=local
SOC_AI_SERVICE_ENABLED=false
SOC_OLLAMA_BASE_URL=http://127.0.0.1:11434
SOC_OLLAMA_MODEL=llama3.1
SOC_OLLAMA_VERIFY_TLS=true
SOC_OLLAMA_CA_CERT=

# GitHub Backlog Integration
# Generate a Personal Access Token (classic) with 'repo' scope at github.com
GITHUB_TOKEN=
GITHUB_REPO=AlfiMuhtadii/enterprise-SIEM

# Infrastructure Credentials (docker-compose services)
# Set these to override the development defaults before deploying.
CLICKHOUSE_USER=detector
CLICKHOUSE_PASSWORD=detector
# ClickHouse transport is plaintext by default for backward-compatible local
# development. Generate the internal CA first, then enable the HTTPS listener.
CLICKHOUSE_TLS_ENABLED=false
CLICKHOUSE_TLS_REQUIRED=false
XDR_CLICKHOUSE_HTTP_URL=http://127.0.0.1:8123
XDR_CLICKHOUSE_VERIFY_TLS=true
# Host scripts: storage/certs/internal-mtls/ca.crt
# Compose app/worker: /etc/xdr/clickhouse-certs/ca.crt
XDR_CLICKHOUSE_CA_CERT=
# Qdrant REST/gRPC TLS is opt-in locally. Both ports switch to TLS together.
QDRANT_TLS_ENABLED=false
QDRANT_TLS_REQUIRED=false
XDR_QDRANT_URL=http://127.0.0.1:6333
SOC_QDRANT_BASE_URL=http://127.0.0.1:6333
XDR_QDRANT_VERIFY_TLS=true
# Host scripts: storage/certs/internal-mtls/ca.crt
# Compose app/queue/scheduler: /etc/xdr/qdrant-certs/ca.crt
XDR_QDRANT_CA_CERT=
# ARCH-DB-SPLIT: telemetry write path stays on Postgres by default. Set to
# "clickhouse" to route high-volume telemetry writes (both
# scripts/ingest_telemetry_events.py / telemetry_stream_worker.py and
# AgentIngestionController::telemetry()) to ClickHouse's telemetry_events
# table instead -- schema created by scripts/xdr_infra_clients.py's
# ClickHouseClient.setup_schema() (run once via scripts/xdr_setup_infra.py).
XDR_TELEMETRY_WRITE_TARGET=postgres
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
OPENSEARCH_INITIAL_ADMIN_PASSWORD=DetectorAdmin123!

# ENT-SEC-OPENSEARCH-OPEN: local/demo runs with the OpenSearch security
# plugin disabled (unauthenticated, plain HTTP) — leave these empty here.
# Production enables the security plugin and requires all three; see
# .env.production.example and docs/operations/PRODUCTION_DEPLOYMENT_PROFILE.md.
XDR_OPENSEARCH_USER=
XDR_OPENSEARCH_PASSWORD=
XDR_OPENSEARCH_VERIFY_TLS=true
